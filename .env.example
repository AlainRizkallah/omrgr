# Sanity (required for the site)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# SEO: canonical base URL (sitemap, robots, Open Graph). Defaults to https://omrgr.co if unset.
# NEXT_PUBLIC_SITE_URL=https://omrgr.co

# Optional: for bootstrap script (write access) and private datasets
# SANITY_API_TOKEN=your-editor-token

# Optional: on-demand revalidation (set in Vercel and use in Sanity webhook)
# REVALIDATION_SECRET=your-secret
